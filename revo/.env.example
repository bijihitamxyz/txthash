# Exness Trading Credentials (Optional - can also be configured via BYOK Vault UI)
EXNESS_ENV=DEMO
EXNESS_API_KEY=
EXNESS_ACCOUNT_ID=

# BYOK AI Confluence LLM Configuration (Optional - can also be configured via BYOK Vault UI)
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=75

# 24/7 Daemon Worker Settings
API_BASE_URL=http://localhost:3000
TICK_INTERVAL_MS=3000
SCAN_SYMBOLS=XAUUSDm,EURUSDm,GBPUSDm,USDJPYm

# Internal AES-256 Vault Encryption Master Salt (Optional)
APP_ENCRYPTION_KEY=EXNESS_AI_QUANT_TRADER_SALT_2026_V1
